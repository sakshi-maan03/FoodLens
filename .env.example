# MONGO_URI: MongoDB connection string (defaults to mongodb://127.0.0.1:27017/foodlens).
# If no local mongod service is running, FoodLens launches an embedded MongoDB instance at ./data/mongodb.
MONGO_URI="mongodb://127.0.0.1:27017/foodlens"

# JWT_SECRET: Secret key used to sign authentication JWT tokens.
JWT_SECRET="foodlens-local-dev-secret-change-in-production"

# PORT: Express server listening port (defaults to 3000).
PORT=3000

# USDA_FDC_API_KEY: Optional USDA FoodData Central key (defaults to DEMO_KEY).
USDA_FDC_API_KEY="DEMO_KEY"
